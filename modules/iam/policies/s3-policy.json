{
  "Version": "2012-10-17",
  "Statement": [
    {
      "Sid": "BucketListAndReadWrite",
      "Effect": "Allow",
      "Action": [
        "s3:ListBucket"
      ],
      "Resource": "${bucket_arn}"
    },
    {
      "Sid": "ObjectReadWrite",
      "Effect": "Allow",
      "Action": [
        "s3:GetObject",
        "s3:PutObject"
      ],
      "Resource": "${bucket_arn}/*"
    }
  ]
}
